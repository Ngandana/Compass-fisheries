# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → Data API
#
# Both values are safe in the browser bundle — the anon key is designed to be
# public, and row level security is what actually protects the data. Never put
# the `service_role` key in this file or anywhere in src/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
